# Database KHUSUS Checklist SOP Harian. Jangan arahkan ke database Parang-ops / Keuangan / Yantos.

# Lokal (docker compose up -d di root repo): kedua URL sama.
DATABASE_URL="postgresql://checklist:checklist@localhost:5434/checklist_sop?schema=public"
DIRECT_URL="postgresql://checklist:checklist@localhost:5434/checklist_sop?schema=public"

# Supabase (tombol Connect):
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
# Password berisi karakter spesial (@ # / ? dll.) harus di-URL-encode.

# --- Semua di bawah ini OPSIONAL untuk development ---
