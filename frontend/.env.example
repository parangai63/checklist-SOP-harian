# Salin ke .env lalu isi bila perlu. Hanya variabel berawalan VITE_ yang terbaca di browser
# dan nilainya ikut tertanam di hasil build — jangan taruh rahasia di sini.

# Kosongkan (disarankan): browser memanggil /api di domain yang sama.
#   dev  → diteruskan Vite ke VITE_API_PROXY_TARGET
#   prod → diteruskan rewrite di vercel.json ke backend
VITE_API_URL=

# Khusus `npm run dev`: ke mana Vite meneruskan /api. Bawaan http://localhost:4200.
VITE_API_PROXY_TARGET=http://localhost:4200
